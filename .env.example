# RideFlow environment configuration.
# Create .env (git-ignored) with random secrets filled in:   ./scripts/init-env.sh
# or copy it by hand and fill in the blanks:                  cp .env.example .env
# The backend reads .env automatically when started from the repo root or backend/; docker compose reads it too.
# Every variable is documented in docs/development.md.

# ---- Spring profile ----------------------------------------------------------
# "demo" loads seed accounts (dev only). Use "prod" in production.
# Read by containers as an environment variable. When running the backend with Maven, pass the profile
# explicitly instead:  ./mvnw spring-boot:run -Dspring-boot.run.profiles=demo
SPRING_PROFILES_ACTIVE=demo

# ---- PostgreSQL + PostGIS (docker compose) -----------------------------------
POSTGRES_DB=rideflow
POSTGRES_USER=rideflow
# REQUIRED. Any strong value for local dev.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ---- Backend datasource ------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/rideflow
DATABASE_USERNAME=rideflow
# REQUIRED. Must match POSTGRES_PASSWORD for local compose.
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10

# ---- Redis --------------------------------------------------------------------
# REQUIRED by docker compose; the backend uses the same value.
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# true for managed Redis over TLS.
REDIS_SSL_ENABLED=false
# false bypasses every cache (used by the cache benchmark for the uncached baseline).
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true

# ---- Routing and geocoding ------------------------------------------------------
# The public OSRM/Nominatim servers are for light development use only.
ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org
# nominatim | disabled
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's policy requires a User-Agent that identifies the application; add a contact if you deploy.
GEOCODING_USER_AGENT=RideFlow/0.1 (+https://github.com/saitharun1903/Rapo)
GEOCODING_COUNTRY_CODES=in

# ---- Kafka ----------------------------------------------------------------------
KAFKA_HOST_PORT=29092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Optional: prefix for topics and consumer groups when environments share a cluster.
KAFKA_TOPIC_PREFIX=
KAFKA_REPLICATION_FACTOR=1

# ---- Reporting ---------------------------------------------------------------------
# Earnings and admin analytics cut hour and day buckets in this zone.
REPORTING_TIME_ZONE=Asia/Kolkata

# ---- AI trip insights ------------------------------------------------------------
# local (Ollama) | external (Anthropic API) | disabled
AI_PROVIDER=disabled
AI_LOCAL_BASE_URL=http://localhost:11434
# Any model you have pulled, e.g. `ollama pull llama3.2`
AI_LOCAL_MODEL=llama3.2
AI_LOCAL_TIMEOUT=120s
# Required only when AI_PROVIDER=external. Never commit a real key.
ANTHROPIC_API_KEY=
AI_EXTERNAL_MODEL=claude-opus-5

# ---- Security ----------------------------------------------------------------
# REQUIRED. At least 32 bytes. Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=rideflow
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d
# A rotated refresh token sent again this soon, while its successor is unused, is a lost response, not theft.
REFRESH_TOKEN_REUSE_GRACE=10s
# false only for plain-http localhost; always true in production.
REFRESH_COOKIE_SECURE=false
# Lax when frontend and API share a site; None (with Secure=true) when they are on different domains.
REFRESH_COOKIE_SAME_SITE=Lax
BCRYPT_STRENGTH=12
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated CIDR ranges of the reverse proxies in front of the backend (e.g. 10.0.0.0/8). Their
# X-Forwarded-For/-Proto/-Host/-Port are honoured; everyone else's are ignored. Empty trusts none, which is right
# locally. List a proxy only if it overwrites or appends X-Forwarded-For; the Next.js frontend alone does neither.
# Single addresses need a mask: 10.1.2.3/32. See docs/development.md.
TRUSTED_PROXIES=
# Optional; leave empty locally. Shared by the backend and the frontend's server (at least 32 bytes:
#   openssl rand -base64 48). The frontend signs each browser's address with it so per-IP limits work behind
# it. Never commit a real one.
CLIENT_IP_SIGNING_SECRET=
# Frontend only, and required with the secret: the header the hosting edge overwrites with the browser's address
# (x-vercel-forwarded-for on Vercel). Never a header a browser can set.
CLIENT_IP_SOURCE_HEADER=

# ---- Initial admin (optional) -----------------------------------------------
# Creates the first ADMIN on startup if none exists. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Demo seed (demo profile only) -------------------------------------------
# REQUIRED with the demo profile. Password for every seeded demo account. Must not contain a single quote.
DEMO_USER_PASSWORD=

# ---- Docker Compose (docker compose up) ----------------------------------------
# Host ports of the containers. Changing FRONTEND_PORT also needs CORS_ALLOWED_ORIGINS to match.
FRONTEND_PORT=3000
BACKEND_PORT=8080
# Where a backend in a container reaches Ollama on the host (AI_LOCAL_BASE_URL is for a backend run on the host).
DOCKER_AI_LOCAL_BASE_URL=http://host.docker.internal:11434
# Driver simulator (docker compose --profile demo), in metres per second: about 40 km/h.
SIM_SPEED_MPS=11

# ---- Server ------------------------------------------------------------------
SERVER_PORT=8080
# Actuator (health, prometheus). Keep off the public internet.
MANAGEMENT_PORT=8081
API_DOCS_ENABLED=true
