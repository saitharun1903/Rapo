    {
      "type": "timeseries",
      "id": 13,
      "title": "Outbox throughput",
      "description": "Events per second sent to Kafka, and failed send attempts (retried).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
