          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(rideflow_offers_total{job=\"rideflow-backend\",outcome=\"accepted\"}[$__range])) / sum(increase(rideflow_offers_total{job=\"rideflow-backend\",outcome=\"created\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
