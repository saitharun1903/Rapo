      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (client_id) (kafka_consumer_fetch_manager_records_lag_max{job=\"rideflow-backend\"})",
          "legendFormat": "{{client_id}}"
        }
