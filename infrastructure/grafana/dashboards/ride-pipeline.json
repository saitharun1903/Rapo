    {
      "type": "stat",
      "id": 5,
      "title": "Time to match (p95)",
      "description": "95th percentile from request to a driver accepting, over the selected range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(rideflow_matching_duration_seconds_bucket{job=\"rideflow-backend\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false
